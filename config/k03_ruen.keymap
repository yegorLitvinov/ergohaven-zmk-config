#include "keys_ru.h"
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        enc_vol: enc_vol {
            compatible = "zmk,behavior-sensor-rotate";
            label = "ENC_VOL";
            #sensor-binding-cells = <0>;
            bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
        };

        bspace_del: bspace_del {
            compatible = "zmk,behavior-mod-morph";
            label = "BSPACE_DEL";
            bindings = <&kp BACKSPACE>, <&kp DELETE>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT | MOD_RSFT)>;
        };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp RU_CYRILLIC_HA>;
            key-positions = <19 20>;
            layers = <1>;
        };

        hrdsgn {
            bindings = <&kp RU_CYRILLIC_HARD_SIGN>;
            key-positions = <45 46>;
            layers = <1>;
        };

        spotlight {
            bindings = <&kp LG(SPACE)>;
            key-positions = <53 54>;
        };

        semicolon_en {
            bindings = <&kp SEMICOLON>;
            key-positions = <3 4>;
            layers = <0>;
        };

        semicolon_ru {
            bindings = <&en SEMI>;
            key-positions = <3 4>;
            layers = <1>;
        };

        double_quote {
            bindings = <&en DOUBLE_QUOTES>;
            key-positions = <6 7>;
        };

        yo {
            bindings = <&kp BACKSLASH>;
            key-positions = <17 16>;
            layers = <1>;
        };

        exclamation {
            bindings = <&kp EXCLAMATION>;
            key-positions = <7 8>;
        };

        sym_en {
            bindings = <&mo 2>;
            key-positions = <51 50>;
            layers = <0>;
        };

        sym_en_right {
            bindings = <&mo 2>;
            key-positions = <58 59>;
            layers = <0>;
        };

        sym_ru {
            bindings = <&mo 3>;
            key-positions = <51 50>;
            layers = <1>;
        };

        sym_ru_right {
            bindings = <&mo 3>;
            key-positions = <58 59>;
            layers = <1>;
        };
    };

    macros {
        to_ru: to_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N2))>;
            label = "TO_RU";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        to_en: to_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(LC(N1))>;
            label = "TO_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_en: layer_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 0 &to_en>;
            label = "LAYER_EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };

        layer_ru: layer_ru {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&to 1 &to_ru>;
            label = "LAYER_RU";
            tap-ms = <30>;
            wait-ms = <0>;
        };

        en: en {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&to_en>,
                <&macro_press>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &kp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&to_ru>;

            label = "EN";
            wait-ms = <0>;
            tap-ms = <30>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        en {
            bindings = <
&kp ESC     &kp MINUS  &kp UNDER  &kp DOT  &kp COMMA         &kp COLON                                              &kp SINGLE_QUOTE  &kp GRAVE  &kp QUESTION  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &layer_ru
&kp AT      &kp Q      &kp W      &kp E    &kp R             &kp T                                                  &kp Y             &kp U      &kp I         &kp O                 &kp P                  &trans
&kp DOLLAR  &kp A      &kp S      &kp D    &kp F             &kp G                                                  &kp H             &kp J      &kp K         &kp L                 &trans                 &trans
&kp TILDE   &kp Z      &kp X      &kp C    &kp V             &kp B           &kp LA(LEFT_COMMAND)    &kp TAB        &kp N             &kp M      &trans        &trans                &trans                 &kp SLASH
                       &mo 5      &mo 4    &kp LEFT_CONTROL  &kp LEFT_SHIFT  &kp LEFT_COMMAND        &kp BACKSPACE  &kp SPACE         &kp ENTER  &mo 4         &mo 5
            >;

            display-name = "Base";
            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        ru {
            display-name = "Ru";
            bindings = <
&trans      &kp MINUS                &kp UNDER             &en DOT             &en COMMA           &en COLON                             &en SINGLE_QUOTE    &en GRAVE                  &en QUESTION         &kp LEFT_PARENTHESIS   &kp RIGHT_PARENTHESIS  &layer_en
&en AT      &kp RU_CYRILLIC_SHORT_I  &kp RU_CYRILLIC_TSE   &kp RU_CYRILLIC_U   &kp RU_CYRILLIC_KA  &kp RU_CYRILLIC_IE                    &kp RU_CYRILLIC_EN  &kp RU_CYRILLIC_GHE        &kp RU_CYRILLIC_SHA  &kp RU_CYRILLIC_SHCHA  &kp RU_CYRILLIC_ZE     &trans
&en DOLLAR  &kp RU_CYRILLIC_EF       &kp RU_CYRILLIC_YERU  &kp RU_CYRILLIC_VE  &kp RU_CYRILLIC_A   &kp RU_CYRILLIC_PE                    &kp RU_CYRILLIC_ER  &kp RU_CYRILLIC_O          &kp RU_CYRILLIC_EL   &kp RU_CYRILLIC_DE     &kp RU_CYRILLIC_ZHE    &trans
&en TILDE   &kp RU_CYRILLIC_YA       &kp RU_CYRILLIC_CHE   &kp RU_CYRILLIC_ES  &kp RU_CYRILLIC_EM  &kp RU_CYRILLIC_I   &trans    &trans  &kp RU_CYRILLIC_TE  &kp RU_CYRILLIC_SOFT_SIGN  &kp RU_CYRILLIC_BE   &kp RU_CYRILLIC_YU     &kp RU_CYRILLIC_E      &kp SLASH
                                     &trans                &trans              &trans              &trans              &trans    &trans  &trans              &trans                     &trans               &trans
            >;

            sensor-bindings =
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>,
                <&enc_vol>;
        };

        sym_en {
            bindings = <
&trans  &trans     &trans        &trans       &trans         &trans                              &trans             &trans            &trans  &trans      &trans         &trans
&trans  &kp HASH   &kp CARET     &kp EQUAL    &trans         &kp LEFT_BRACE                      &kp RIGHT_BRACE    &trans            &trans  &kp DOLLAR  &kp BACKSLASH  &trans
&trans  &trans     &kp ASTERISK  &trans       &trans         &trans                              &trans             &trans            &trans  &kp AMPS    &kp PIPE       &trans
&trans  &kp TILDE  &kp PLUS      &kp AT       &kp LESS_THAN  &kp LEFT_BRACKET  &trans    &trans  &kp RIGHT_BRACKET  &kp GREATER_THAN  &trans  &trans      &kp SLASH      &trans
                   &trans        &kp PERCENT  &trans         &trans            &trans    &trans  &trans             &trans            &trans  &trans
            >;

            display-name = "Sym En";
        };

        sym_ru {
            display-name = "Sym Ru";
            bindings = <
&trans  &trans     &trans        &trans       &trans         &trans                              &trans             &trans            &trans  &trans      &trans         &trans
&trans  &en HASH   &en CARET     &kp EQUAL    &trans         &en LEFT_BRACE                      &en RIGHT_BRACE    &trans            &trans  &en DOLLAR  &en BACKSLASH  &trans
&trans  &trans     &en ASTERISK  &trans       &trans         &trans                              &trans             &trans            &trans  &en AMPS    &en PIPE       &trans
&trans  &en TILDE  &kp PLUS      &en AT       &en LESS_THAN  &en LEFT_BRACKET  &trans    &trans  &en RIGHT_BRACKET  &en GREATER_THAN  &trans  &trans      &kp SLASH      &trans
                   &trans        &en PERCENT  &trans         &trans            &trans    &trans  &trans             &trans            &trans  &trans
            >;
        };

        apps_nav {
            bindings = <
&trans  &trans             &trans             &trans             &trans             &trans                                &trans              &trans          &trans        &trans               &trans  &trans
&none   &kp LG(LC(LA(Q)))  &kp LG(LC(LA(W)))  &kp LG(LC(LA(E)))  &kp LG(LC(LA(R)))  &kp LG(LC(LA(T)))                     &kp RA(LEFT_ARROW)  &kp PAGE_DOWN   &kp PAGE_UP   &kp RA(RIGHT_ARROW)  &none   &none
&none   &kp LG(LC(LA(A)))  &kp LG(LC(LA(S)))  &kp LG(LC(LA(D)))  &kp LG(LC(LA(F)))  &kp LG(LC(LA(G)))                     &kp LEFT            &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT            &none   &none
&none   &kp LG(LC(LA(Z)))  &kp LG(LC(LA(X)))  &kp LG(LC(LA(C)))  &kp LG(LC(LA(V)))  &kp LG(LS(NUMBER_5))  &none    &none  &kp LG(LEFT_ARROW)  &kp LG(DOWN)    &kp LG(UP)    &kp LG(RIGHT_ARROW)  &none   &none
                           &none              &none              &none              &none                 &none    &none  &none               &none           &none         &none
            >;

            label = "Applications & Navigation";
        };

        num_media {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                   &trans            &trans                &trans        &trans        &trans        &trans
&none   &none   &kp N7  &kp N8  &kp N9  &none                    &bt BT_SEL 0      &bt BT_SEL 1          &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&none   &kp N0  &kp N4  &kp N5  &kp N6  &none                    &kp C_PLAY_PAUSE  &kp C_VOL_DN          &kp C_VOL_UP  &none         &none         &none
&none   &none   &kp N1  &kp N2  &kp N3  &none   &none     &none  &none             &kp C_BRIGHTNESS_DEC  &kp C_BRI_UP  &none         &none         &none
                &none   &none   &none   &none   &trans    &none  &none             &none                 &none         &none
            >;

            display-name = "Numbers & Media";
        };
    };
};
